# Copy this file to .env and fill in real values on the VPS.
# .env is gitignored — never commit real secrets.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

DEBUG=False

# Comma-separated, no spaces. Include both apex and www if you use both.
ALLOWED_HOSTS=example.com,www.example.com

# Comma-separated, must include the scheme (https://) and no trailing slash.
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Used by the nginx container to render its config (server_name, SSL cert
# paths under /etc/letsencrypt/live/$DOMAIN/) and to build the redirect URL.
DOMAIN=example.com

# Set to "true" only once a real certificate exists at
# /etc/letsencrypt/live/$DOMAIN/ on the host (see DEPLOY.md). Leave "false"
# for local `docker compose up` testing.
ENABLE_SSL=false
